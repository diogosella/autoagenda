# Sem credenciais: demonstração local com persistência em .data/demo.json.
PORT=3001
# Configure as TRÊS para usar Supabase. Nunca use prefixo VITE_ nas chaves privadas.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SHOP_ID=10000000-0000-4000-8000-000000000001
# Opcional: sem chave, interpretação por regras, identificada como simulação na tela.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Para IA local, configure AI_PROVIDER=ollama.
AI_PROVIDER=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b

# WhatsApp Cloud API (Meta). Veja docs/whatsapp-setup.md.
# Token de verificação: um texto qualquer criado por você e repetido no painel da Meta.
WHATSAPP_VERIFY_TOKEN=
# Token de acesso e ID do número (App Dashboard > WhatsApp > API Setup).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Chave secreta do app (App settings > Basic): confere a assinatura de cada mensagem.
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v25.0
